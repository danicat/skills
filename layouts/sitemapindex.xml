{{ printf "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{{- $todayIso := now.Format "2006-01-02" -}}
{{- $enSite := index . 0 }}
  <url>
    <loc>https://skills.danicat.dev/</loc>
    <lastmod>{{ $todayIso }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://skills.danicat.dev/pt-br/</loc>
    <lastmod>{{ $todayIso }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://skills.danicat.dev/ja/</loc>
    <lastmod>{{ $todayIso }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
{{- range $sec := $enSite.Sections.ByWeight -}}
  {{- $secSkills := where $sec.Pages "Params.isCompanion" false -}}
  {{- range $s := $secSkills.ByTitle }}
  <url>
    <loc>https://skills.danicat.dev/{{ $s.Params.category }}/{{ $s.Params.folder }}/</loc>
    <lastmod>{{ $todayIso }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.85</priority>
  </url>
  <url>
    <loc>https://skills.danicat.dev/pt-br/{{ $s.Params.category }}/{{ $s.Params.folder }}/</loc>
    <lastmod>{{ $todayIso }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://skills.danicat.dev/ja/{{ $s.Params.category }}/{{ $s.Params.folder }}/</loc>
    <lastmod>{{ $todayIso }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  {{- end -}}
{{- end }}
</urlset>
