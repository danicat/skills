{{ printf "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{{- $freshData := site.Data.freshness | default dict -}}
{{- $freshSkills := $freshData.skills | default $freshData -}}
{{- $maxCommitDate := "2026-10-14" -}}
{{- range $k, $v := $freshSkills -}}
  {{- if reflect.IsMap $v -}}
    {{- with $v.lastCommitDate -}}
      {{- if gt . $maxCommitDate -}}
        {{- $maxCommitDate = . -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- $fallbackDate := $maxCommitDate -}}
{{- with $freshData.generatedAt -}}
  {{- $fallbackDate = substr (string .) 0 10 -}}
{{- end -}}
{{- /* Iterate .Site.AllPages (via site.AllPages) filtering out 404 and non-canonical pages */ -}}
{{- range $p := site.AllPages -}}
  {{- if and (ne $p.Kind "404") (ne $p.Kind "taxonomy") (ne $p.Kind "term") $p.Permalink -}}
    {{- $skillKey := lower ($p.Params.skillName | default $p.Title | default "") -}}
    {{- $skillEntry := index $freshSkills $skillKey -}}
    {{- $lastmod := $fallbackDate -}}
    {{- if and $skillEntry (reflect.IsMap $skillEntry) -}}
      {{- with $skillEntry.lastCommitDate | default $skillEntry.lastModified | default $skillEntry.lastCommitAt -}}
        {{- $lastmod = substr (string .) 0 10 -}}
      {{- end -}}
    {{- end -}}
    {{- $priority := "0.8" -}}
    {{- if $p.IsHome -}}
      {{- $priority = cond (eq $p.Language.LanguageCode "en") "1.0" "0.9" -}}
    {{- else if and $p.Params.isCompanion (not $p.Params.isSpecialPage) -}}
      {{- $priority = "0.7" -}}
    {{- else if eq $p.Language.LanguageCode "en" -}}
      {{- $priority = "0.85" -}}
    {{- end }}
  <url>
    <loc>{{ $p.Permalink }}</loc>
    <lastmod>{{ $lastmod }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>{{ $priority }}</priority>
    {{- range $p.AllTranslations }}
    <xhtml:link rel="alternate" hreflang="{{ .Language.LanguageCode }}" href="{{ .Permalink }}"/>
    {{- if eq .Language.LanguageCode "en" }}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ .Permalink }}"/>
    {{- end }}
    {{- end }}
  </url>
  {{- end -}}
{{- end -}}
{{- range $gUrl := slice "https://skills.danicat.dev/graveyard/" "https://skills.danicat.dev/pt-br/graveyard/" "https://skills.danicat.dev/ja/graveyard/" }}
  <url>
    <loc>{{ $gUrl }}</loc>
    <lastmod>{{ $fallbackDate }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.75</priority>
    <xhtml:link rel="alternate" hreflang="en" href="https://skills.danicat.dev/graveyard/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://skills.danicat.dev/graveyard/"/>
    <xhtml:link rel="alternate" hreflang="pt-BR" href="https://skills.danicat.dev/pt-br/graveyard/"/>
    <xhtml:link rel="alternate" hreflang="ja" href="https://skills.danicat.dev/ja/graveyard/"/>
  </url>
{{- end }}
</urlset>

